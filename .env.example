# Куки авторизации RuTracker (bb_session, bb_guid)
RUTRACKER_COOKIES='bb_session=...; bb_guid=...'

# User-Agent браузера, решавшего Cloudflare
RUTRACKER_UA='Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'

# Локальный сервис обхода Cloudflare (CloudflareBypassForScraping)
# RUTRACKER_CF_BYPASS=http://localhost:8000

# Опциональный прокси-сервер (HTTP или SOCKS5)
# RUTRACKER_PROXY=socks5://127.0.0.1:1080

# Отключить curl_cffi (все запросы через браузер)
# RUTRACKER_NO_CURL=1
